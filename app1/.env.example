# ── Yoga Pose Correction engine ────────────────────────────────────────────
# Base URL the browser uses to reach the correction engine.
# In development, leave this as the default "/correction-api": the Vite dev
# proxy (see vite.config.js) forwards it to the engine. Only override for a
# production deployment where the engine is reachable at an absolute URL.
VITE_CORRECTION_API_BASE=/correction-api

# Where the Vite dev proxy forwards /correction-api/* (dev only).
# Change if the correction engine runs on a different host/port.
CORRECTION_ENGINE_URL=http://127.0.0.1:3002
